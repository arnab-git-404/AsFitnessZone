
# As FitnessZone - Environment Variables
MONGODB_URI=mongodb://localhost:27017/fitnessgym

# ---------- JWT Authentication ----------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-different-refresh-secret-change-this-too

# ---------- Cloudinary Media Storage ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ---------- Email (Resend) ----------
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@asfitnesszone.com

# ---------- Admin Seeder ----------
ADMIN_EMAIL=admin@asfitnesszone.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin

# ---------- App Configuration ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
